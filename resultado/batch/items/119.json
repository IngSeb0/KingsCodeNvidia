89:4d51e5b1ecad"], "evidence_in_prompt": 8, "evidence_passages": 8, "field_coercions": [], "format_warnings": ["semi_open_sentences_2_outside_3_5"], "generation_ms": 11692.179899999246, "input_tokens": 4034, "json_grammar": null, "json_grammar_sha256": null, "model": "qwen3-8b", "normalization_action": "none", "output_tokens": 317, "peak_reserved_vram_bytes": 20468203520, "peak_vram_bytes": 20095932416, "prompt_sha256": "af8381c1827ebaa6e5d3cae87b86b1d21bf12eeadfd0bf2903d3234c197c4170", "prompt_version": "grounded-formats-v6", "raw_response": "{\n  \"abstencion\": false,\n  \"respuesta\": \"Los requisitos del contrato de promesa para que se produzcan obligaciones son: que la promesa conste por escrito, que el contrato a que se refiere no sea ineficaz por no cumplir los requisitos del artículo 1502 del Código Civil, que contenga un plazo o condición que fije la época en que se celebrará el contrato y que se determine de tal suerte el contrato que para perfeccionarlo solo falte la tradición de la cosa o las formalidades legales. Estos requisitos están establecidos en el artículo 1611 del Código Civil, subrogado por el artículo 89 de la Ley 153 de 1887.\",\n  \"palabras_clave\": [\"contrato de promesa\", \"obligaciones\", \"requisitos\", \"Código Civil\", \"Ley 153 de 1887\"],\n  \"referencia_legal\": \"artículo 1611 del Código Civil, subrogado por el artículo 89 de la Ley 153 de 1887\",\n  \"pasajes_usados\": [\"codigo_civil:01609:5467d88e4e89\", \"ley_153_de_1887:00089:4d51e5b1ecad\"]\n}", "repair_actions": {"rewritten_to_body": 1}, "revision": "b968826d9c46dd6066d109eabc6255188de91218", "xgrammar_version": null}, "final_passage_ids": ["codigo_civil:01609:5467d88e4e89", "ley_153_de_1887:00089:4d51e5b1ecad", "codigo_comercio:00119:6afe1316d145", "codigo_comercio:00878:4872990aaaf4", "ley_153_de_1887:00088:2cbe1b8d9035", "codigo_civil:01522:81804909ef80", "codigo_civil:01505:c1dd328afbc6", "codigo_civil:00109:f7788b64cf17"], "flat_passage_ids": ["codigo_civil:01609:546