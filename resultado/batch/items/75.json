ta\",\"perfeccionamiento\",\"entrega\",\"precio\"],\"referencia_legal\":\"codigo_comercio:00923:fd12dd6d7f67; codigo_civil:02409:9ba0cb50ee93\",\"pasajes_usados\":[\"codigo_comercio:00923:fd12dd6d7f67\",\"codigo_civil:02409:9ba0cb50ee93\"]}", "repair_actions": {}, "revision": "b968826d9c46dd6066d109eabc6255188de91218", "xgrammar_version": null}, "final_passage_ids": ["codigo_civil:01847:0fbb868c8f05", "codigo_civil:02409:9ba0cb50ee93", "codigo_comercio:01106:f65f7780a57d", "codigo_comercio:00923:fd12dd6d7f67", "decreto_1082_de_2015:00054:0304508ed13d", "codigo_civil:02458:23031a193d7c", "codigo_general_proceso:00384:581895e82e0e", "codigo_comercio:00927:0fe0d398100d"], "flat_passage_ids": ["codigo_civil:01847:0fbb868c8f05", "codigo_civil:02409:9ba0cb50ee93", "codigo_comercio:01106:f65f7780a57d", "codigo_comercio:00923:fd12dd6d7f67", "decreto_1082_de_2015:00054:0304508ed13d", "codigo_civil:02458:23031a193d7c", "codigo_general_proceso:00384:581895e82e0e", "codigo_comercio:00927:0fe0d398100d"], "format_retriever": "hybrid", "graph_decision": "off", "graph_execution": "off", "id": 75, "latency_ms": 8908.113200000116, "locator_control": null, "native_option_fusion": false, "option_support": null, "option_support_enabled": false, "option_support_ms": null, "plan": null, "plan_roles": ["Q1", "Q2", "Q3"], "query": {"authorities": [], "expansions": [], "normalized": "¿Cuáles son los elementos esenciales requeridos para el perfeccionamiento de un contrato de compraventa?", "original": "¿Cuáles son los elementos esenciales requeridos para el perfeccionamiento de un contrato de compraventa?", "references": [], "retrieval_text": "¿Cuáles son los elementos esenciales requeridos para el perfeccionamiento de un contrato de compraventa?", "signals": [], "version": "legal-query-v1"}, "rerank_skipped": false, "retrieval_mode": "option", "retrieval_ms": 49.32389999976294, "retrieval_profiles": [{"bm25_ms": 6.173, "candidate_count": 30, "candidate_k": 30, "dense_encode_batches": 1, "den