ra otra especie similar de propaganda escrita, no serán obligatorias para el que las haga.\",\"palabras_clave\":[\"impuesto de timbre nacional\",\"oferta mercantil\",\"Código de Comercio\"],\"referencia_legal\":\"Código de Comercio (Decreto 410 de 1971), ARTÍCULO 847.\",\"pasajes_usados\":[\"codigo_comercio:00864:3bb0f389bf68\"]}", "repair_actions": {"suppressed_fragment": 1, "suppressed_sentence": 1}, "revision": "b968826d9c46dd6066d109eabc6255188de91218", "xgrammar_version": null}, "final_passage_ids": ["estatuto_tributario:00884:e87c7c65d7a1", "estatuto_tributario:00887:9e60cba3803d", "estatuto_tributario:00877:14ac7b06aff8", "estatuto_tributario:00891:84ba2f91d8e9", "estatuto_tributario:00883:3062cbbda154", "estatuto_tributario:00868:bde028bcf578", "estatuto_tributario:00878:25fec057cd41", "codigo_comercio:00864:3bb0f389bf68"], "flat_passage_ids": ["estatuto_tributario:00884:e87c7c65d7a1", "estatuto_tributario:00887:9e60cba3803d", "estatuto_tributario:00877:14ac7b06aff8", "estatuto_tributario:00891:84ba2f91d8e9", "estatuto_tributario:00883:3062cbbda154", "estatuto_tributario:00868:bde028bcf578", "estatuto_tributario:00878:25fec057cd41", "codigo_comercio:00864:3bb0f389bf68"], "format_retriever": "hybrid", "graph_decision": "off", "graph_execution": "off", "id": 170, "latency_ms": 9130.624499999612, "locator_control": null, "native_option_fusion": false, "option_support": null, "option_support_enabled": false, "option_support_ms": null, "plan": null, "plan_roles": ["Q1", "Q2", "Q3"], "query": {"authorities": [], "expansions": [], "normalized": "¿Cuál es el fragmento literal de la norma del impuesto de timbre nacional en el que se establece que la suscripción de ofertas mercantiles aceptadas a través de orden de compra está exenta de impuesto de timbre nacional?", "original": "¿Cuál es el fragmento literal de la norma del impuesto de timbre nacional en el que se establece que la suscripción de ofertas mercantiles aceptadas a través de orden de compra está exenta de